{
  "name": "trip-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Family & Group Trip Management PWA (single trip, V1)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-trip \"vitest run --config vitest.rules.config.ts\"",
    "icons": "node scripts/gen-icons.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-trip",
    "check:functions": "cd supabase/functions && npx -y deno@2 check files/index.ts notify/index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "firebase": "11.10.0",
    "idb-keyval": "6.3.0",
    "lucide-react": "0.511.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-router-dom": "7.18.6",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "4.7.0",
    "firebase-tools": "14.27.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  }
}
